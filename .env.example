# Your deployed site's public URL — used for SEO tags (Open Graph, sitemap.xml, robots.txt).
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Supabase project (Project Settings -> API in the Supabase dashboard) — required, see
# README "Getting started" for how to create these.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
# Server-only — never expose to the browser. Used only by the Admin page's "list all users" route.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Alternative to config/credentials.json — env vars override the JSON config if set.

# "tiktok" (default, free, scrapes public TikTok pages — no key needed),
# "rapidapi" (paid, more reliable), or "mock" (offline demo data)
DATA_PROVIDER=tiktok

# How many videos to fetch per channel when scraping live (see credentials.example.json for details)
MAX_VIDEOS_TO_FETCH=300

# How many videos to scan per Niche Stats keyword search
NICHE_MAX_VIDEOS=500

# RECOMMENDED way to set a TikTok session cookie — paste the raw Cookie request
# header value from a real browser tab here. This is easier and safer than
# putting it in config/credentials.json, since .env values need NO escaping
# even though real TikTok cookies contain " and \ characters that would
# otherwise break that file's JSON syntax. See README "How to get a cookie".
TIKTOK_COOKIE=

# Debugging a channel that returns no videos — see README "Troubleshooting: no videos returned"
TIKTOK_SCRAPE_HEADLESS=true
TIKTOK_SCRAPE_DEBUG=0

# Reuse a saved browser session (data/session-state.json) across scrapes instead of starting
# fresh every time — set to false to disable. See credentials.example.json for details.
PERSIST_SESSION=true

# Used by Settings' "Translate from English" button for Niche Finder search terms — a
# LibreTranslate-compatible API. Defaults to the free public instance; self-host your own for
# reliability (see README "Translating Niche Finder terms").
TRANSLATE_API_URL=https://libretranslate.com/translate
TRANSLATE_API_KEY=

# Only used when DATA_PROVIDER=rapidapi
RAPIDAPI_KEY=
RAPIDAPI_HOST=tiktok-scraper7.p.rapidapi.com

# Stripe Checkout — required for the Billing page to work. Create products/prices in the
# Stripe dashboard matching your plans (see Admin -> Plans), paste each price ID into that
# plan's "Stripe price ID" field, then flip "Payments enabled" on in the Admin dashboard.
# Webhook secret comes from `stripe listen --forward-to localhost:3000/api/webhooks/stripe`
# locally, or the endpoint's signing secret in the Stripe dashboard in production.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
